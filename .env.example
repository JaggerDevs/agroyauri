# =====================================================================
# Variables PÚBLICAS (van al HTML/JS del navegador). Prefijo PUBLIC_.
# Configúralas en Cloudflare Pages → Settings → Environment variables
# (y en un archivo .env local para desarrollo). NUNCA pongas secretos aquí.
# =====================================================================

# URL pública definitiva, sin barra final (canonical, sitemap, Open Graph)
PUBLIC_SITE_URL=https://agroyauri.pages.dev

# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "anon"/"publishable": es pública por diseño; RLS protege los datos.
PUBLIC_SUPABASE_ANON_KEY=

# Opcionales (déjalas vacías si aún no existen; no se inyecta nada)
# Google Analytics 4, ej. G-XXXXXXXXXX
PUBLIC_GA_ID=
# Search Console, método "etiqueta HTML" (solo el valor de content)
PUBLIC_GSC_VERIFICATION=
# Cloudflare Turnstile (antispam), site key
PUBLIC_TURNSTILE_SITE_KEY=

# =====================================================================
# Variables SECRETAS — SOLO para las Cloudflare Functions (/api/*).
# Cloudflare Pages → Settings → Environment variables → tipo "Secret".
# En local van en .dev.vars (ignorado por git). NUNCA con prefijo PUBLIC_.
# =====================================================================
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # Supabase → API → service_role / secret key
# CF_DEPLOY_HOOK_URL=             # Cloudflare Pages → Settings → Builds → Deploy hooks
# TURNSTILE_SECRET_KEY=           # opcional, pareja de PUBLIC_TURNSTILE_SITE_KEY
