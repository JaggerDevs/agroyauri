---
import Img from "./Img.astro";
import type { Service } from "../lib/data";
import { serviceImagePosition } from "../lib/site";
interface Props { service: Service; sizes?: string }
const { service: s, sizes = "(max-width: 760px) 72vw, (max-width: 1180px) 33vw, 220px" } = Astro.props;
---
<article class="service-card">
  <a href={`/servicios/${s.slug}`} class="card-link" aria-label={s.name}></a>
  <div class="media">
    <Img src={s.image_url} alt={s.name} widths={[320, 480, 640]} sizes={sizes} style={`object-position:${serviceImagePosition(s)}`} />
  </div>
  <div class="body">
    <h3>{s.icon && <svg class="svc-ico" aria-hidden="true"><use href={`#svc-${s.icon}`} /></svg>}{s.name}</h3>
    {s.short_description && <p>{s.short_description}</p>}
  </div>
</article>
