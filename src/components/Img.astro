---
// Imagen responsive (AVIF/WebP + srcset + width/height) a partir de una ruta de la BD.
import { Picture } from "astro:assets";
import { resolveImage } from "../lib/media";

interface Props {
  src: string | null | undefined;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  style?: string;
}
const { src, alt, widths = [400, 800], sizes = "(max-width: 760px) 80vw, 400px", loading = "lazy", fetchpriority, class: cls, style } = Astro.props;
const image = resolveImage(src);
const remote = typeof image === "string";
---
{image && (
  <Picture
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={["avif", "webp"]}
    loading={loading}
    decoding={loading === "eager" ? "sync" : "async"}
    fetchpriority={fetchpriority}
    class={cls}
    style={style}
    {...(remote ? { inferSize: true } : {})}
  />
)}
