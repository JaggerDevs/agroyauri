---
import Img from "./Img.astro";
interface Props {
  /** Ya no se muestra (el cliente pidió quitar los textos pequeños sobre los títulos). */
  eyebrow?: string;
  /** Admite <span class="lime">…</span> */
  title: string;
  lead?: string | null;
  image?: string | null;
  crumbs: { name: string; path: string }[];
  imagePosition?: string;
}
const { title, lead, image = "/media/site/jardin-casa.jpg", crumbs, imagePosition = "center 60%" } = Astro.props;
---
<section class="page-hero">
  <Img src={image} alt="" class="hero-bg" widths={[640, 960, 1440]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position:${imagePosition}`} />
  <div class="container page-hero-inner">
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      {crumbs.map((c, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> &nbsp;/&nbsp; </span>}
          {i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </>
      ))}
    </nav>
  </div>
  <svg class="hero-wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,58 C160,20 330,18 520,48 C720,80 860,112 1060,96 C1220,84 1340,52 1440,30 L1440,120 L0,120 Z" fill="#fbfaf4" />
  </svg>
</section>
