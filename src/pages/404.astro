---
import Base from "../layouts/Base.astro";
---
<Base title="Página no encontrada | AGROYAURI SAC" description="La página que buscas no existe o fue movida." noindex path="/404">
  <section class="notfound">
    <div class="container">
      <p class="code">404</p>
      <h1>No encontramos esta página</h1>
      <p>Puede que el enlace haya cambiado. Estas secciones te pueden ayudar:</p>
      <div class="notfound-links">
        <a href="/" class="btn btn-dark">Inicio</a>
        <a href="/servicios" class="btn btn-outline-dark">Servicios</a>
        <a href="/proyectos" class="btn btn-outline-dark">Proyectos</a>
        <a href="/contacto" class="btn btn-outline-dark">Contacto</a>
      </div>
    </div>
  </section>
</Base>
